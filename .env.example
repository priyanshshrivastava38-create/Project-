# Copy to .env and replace every placeholder. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_DB=metalflow
POSTGRES_USER=metalflow
POSTGRES_PASSWORD=change-me-local-db-password
# For running the API outside Docker:
DATABASE_URL=postgresql+psycopg://localhost:5432/metalflow

# --- Security ---
ENVIRONMENT=development            # development | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false        # true behind HTTPS (production)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- First start ---
# Demo data: seeds only when the users table is empty. Otherwise the bootstrap step creates
# production stages/warehouses and the first admin from ADMIN_EMAIL/ADMIN_PASSWORD (empty DB only).
SEED_DEMO_DATA=true
DEMO_PASSWORD=choose-a-demo-password   # required when seeding with ENVIRONMENT=production
ADMIN_EMAIL=
ADMIN_PASSWORD=                    # >= 12 chars; remove after the first start
ADMIN_NAME=Administrator

# --- Hardening ---
ENABLE_API_DOCS=                   # empty = on outside production, off in production
LOGIN_MAX_FAILURES_PER_ACCOUNT=5   # per account+IP within LOGIN_RATE_WINDOW_SECONDS
LOGIN_MAX_FAILURES_PER_IP=50
LOGIN_RATE_WINDOW_SECONDS=900

# --- Business settings ---
DEFAULT_TAX_RATE=0.00
SCRAP_ALLOWANCE_PCT=5
MAX_UPLOAD_MB=10

# --- AI assistant (optional; "none" = deterministic answers, no API key needed) ---
AI_PROVIDER=none                   # none | openai | anthropic
AI_API_KEY=
AI_BASE_URL=                       # e.g. http://localhost:11434/v1 for Ollama (openai-compatible)
AI_MODEL=
